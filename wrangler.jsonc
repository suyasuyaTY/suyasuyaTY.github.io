{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-11-01",
  // Astro が dist/ に出力した静的ファイルをそのまま配信する (Worker スクリプトは持たない)
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "suyasuyaty.com", "custom_domain": true }],
  // *.workers.dev では公開しない (独自ドメインに一本化する)
  "workers_dev": false,
  "preview_urls": true
}
