---
import { ClientRouter } from "astro:transitions";
import Header from "@components/common/Header.astro";
import Sidebar from "@components/common/Sidebar.astro";
import "@styles/global.css";

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
}

const {
  title,
  description = "寿司と競プロが好きです",
  ogImage = "/ogp.png",
  ogType = "website",
} = Astro.props;

const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.href;

const ogImageUrl = Astro.site ? new URL(ogImage, Astro.site).href : ogImage;

const verticalSlideTransition = {
  old: {
    name: "slideDownFadeOut",
    duration: "0.2s",
    easing: "ease-in",
    fillMode: "forwards",
  },
  new: {
    name: "slideUpFadeIn",
    duration: "0.2s",
    delay: "0.4s",
    easing: "ease-out",
    fillMode: "backwards",
  },
} as const;

const customTransition = {
  forwards: verticalSlideTransition,
  backwards: verticalSlideTransition,
};
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>

    {/* 基本 */}
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" />

    {/* OGP */}
    <meta property="og:site_name" content="suyasuyaTYの部屋" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />

    <ClientRouter />
    <style is:global>
      @keyframes slideDownFadeOut {
        to {
          transform: translateY(30px);
          opacity: 0;
        }
      }
      @keyframes slideUpFadeIn {
        from {
          transform: translateY(30px);
          opacity: 0;
        }
      }
    </style>
  </head>
  <body class="animate-background font-sans md:mx-auto md:max-w-7xl">
    <Header />
    <div
      class="mx-auto mt-4 flex flex-col items-start gap-4 md:flex-row md:gap-6"
    >
      <main
        transition:animate={customTransition}
        class="widget-card flex w-full flex-col gap-6 md:order-2 md:w-4/5"
      >
        <slot />
      </main>

      <aside class="order-1 flex w-full shrink-0 flex-col gap-6 md:w-1/5">
        <Sidebar />
      </aside>
    </div>
  </body>
</html>

<script is:inline>
  document.addEventListener("astro:after-swap", () => {
    window.scrollTo({ left: 0, top: 0, behavior: "instant" });
  });
</script>
