---
import { ClientRouter } from "astro:transitions";
import Header from "@components/common/Header.astro";
import Sidebar from "@components/common/Sidebar.astro";
import "@styles/global.css";

export interface Props {
  title: string;
}

const { title } = Astro.props;

// アニメーション定義は変更なし
const verticalSlideTransition = {
  old: {
    name: "slideDownFadeOut",
    duration: "0.2s",
    easing: "ease-in",
    fillMode: "forwards",
  },
  new: {
    name: "slideUpFadeIn",
    duration: "0.2s",
    delay: "0.4s",
    easing: "ease-out",
    fillMode: "backwards",
  },
} as const;

const customTransition = {
  forwards: verticalSlideTransition,
  backwards: verticalSlideTransition,
};
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <ClientRouter />
    <style is:global>
      @keyframes slideDownFadeOut {
        to {
          transform: translateY(30px);
          opacity: 0;
        }
      }
      @keyframes slideUpFadeIn {
        from {
          transform: translateY(30px);
          opacity: 0;
        }
      }
    </style>
  </head>
  <body class="animate-background font-sans md:mx-auto md:max-w-7xl">
    <Header />
    <div
      class="mx-auto mt-4 flex flex-col items-start gap-4 md:flex-row md:gap-6"
    >
      <main
        transition:animate={customTransition}
        class="widget-card flex w-full flex-col gap-6 md:order-2 md:w-4/5"
      >
        <slot />
      </main>

      <aside class="order-1 flex w-full shrink-0 flex-col gap-6 md:w-1/5">
        <Sidebar />
      </aside>
    </div>
  </body>
</html>

<script is:inline>
  document.addEventListener("astro:after-swap", () => {
    window.scrollTo({ left: 0, top: 0, behavior: "instant" });
  });
</script>
