---
import Header from "@components/Header.astro";
import Sidebar from "@components/Sidebar.astro";
import "@styles/global.css";

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-gray-100 font-sans text-gray-800 md:mx-auto md:max-w-7xl">
    <Header />
    <main class="mx-auto mt-4 flex gap-6">
      <aside class="w-full shrink-0 md:w-1/5">
        <Sidebar />
      </aside>
      <div
        class="w-full rounded-lg bg-white p-6 shadow-sm md:w-4/5 md:p-8"
        transition:animate="fade"
      >
        <slot />
      </div>
    </main>
  </body>
</html>
