---
import { Icon } from "astro-icon/components";

import Thumbnail from "./Thumbnail.astro";

import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  url: string;
  description?: string;
  creator: string;
  image: ImageMetadata;
  darkImage?: ImageMetadata;
}

const { title, url, description, creator, image, darkImage } = Astro.props;
---

<li class="list-none">
  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="link-card group"
  >
    <div class="shrink-0">
      <Thumbnail image={image} darkImage={darkImage} />
    </div>

    <div class="ml-4 flex h-20 min-w-0 flex-1 flex-col gap-0.5 sm:h-28">
      <h3 class="line-clamp-1 font-bold transition-colors group-hover:text-(--color-primary)">
        {title}
      </h3>
      <p class="line-clamp-2 flex-1 text-sm sm:line-clamp-3 text-(--color-text-muted)">
        {description}
      </p>
      <p class="line-clamp-1 text-sm text-(--color-text-muted)">{creator}</p>
    </div>
    <div class="link-card-arrow-container">
      <Icon
        name="heroicons:chevron-right-16-solid"
        class="link-card-arrow-icon"
      />
    </div>
  </a>
</li>

<style>
  .link-card {
    display: flex;
    align-items: center;
    border-radius: 1rem;
    border: 1px solid var(--color-border);
    padding: 1rem;
    background-color: var(--color-bg-surface);
    color: var(--color-text-body);
    transition: box-shadow 200ms;
  }

  .link-card:hover {
    border-color: var(--color-primary);
    background-color: color-mix(in srgb, var(--color-primary) 5%, transparent);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.12);
    transition:
      box-shadow 200ms,
      background-color 200ms,
      border-color 200ms;
  }

  .link-card-arrow-container {
    pointer-events: none;
    display: flex;
    height: 6rem;
    width: 2rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 0.375rem;
    opacity: 0;
    background-color: color-mix(in srgb, var(--color-primary) 15%, transparent);
    transition: opacity 200ms;
  }

  .link-card:hover .link-card-arrow-container {
    opacity: 1;
  }

  .link-card-arrow-icon {
    transform: translateX(-0.75rem);
    color: var(--color-primary);
    transition: transform 200ms;
  }

  .link-card:hover .link-card-arrow-icon {
    transform: translateX(0);
  }
</style>
