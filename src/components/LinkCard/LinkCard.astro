---
import { Image } from "astro:assets";

interface Props {
  title: string;
  url: string;
  description: string;
  image: string;
  darkImage?: string;
}

const { title, url, description, image, darkImage } = Astro.props;
---

<li class="group h-full list-none">
  <a href={url} target="_blank" rel="noopener noreferrer" class="link-card">
    <div class="link-card-arrow-container">
      <Image
        src={image}
        alt={title}
        height={72}
        width={72}
        class:list={[
          "object-cover transition-opacity group-hover:opacity-30",
          darkImage ? "dark:hidden" : "",
        ]}
      />

      {
        darkImage && (
          <Image
            src={darkImage}
            alt={title}
            height={72}
            width={72}
            class="hidden object-cover transition-opacity group-hover:opacity-30 dark:block"
          />
        )
      }

      <div
        class="absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-300 group-hover:opacity-100"
      >
        <span class="link-card-arrow"></span>
      </div>
    </div>

    <div class="flex h-16 flex-1 flex-col justify-between py-0.5">
      <h3
        class="line-clamp-2 text-base leading-tight font-bold text-(--color-text-heading) group-hover:text-(--color-primary)"
      >
        {title}
      </h3>
      <p class="text---color-text-muted) line-clamp-1 text-xs">
        {description}
      </p>
    </div>
  </a>
</li>
