---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  url: string;
  description?: string;
  creator: string;
  image: ImageMetadata;
  darkImage?: ImageMetadata;
}

const { title, url, description, creator, image, darkImage } = Astro.props;
---

<li class="list-none">
  <a href={url} target="_blank" rel="noopener noreferrer" class="link-card">
    <div class="link-card-thumb">
      <Image
        src={image}
        alt=""
        width={96}
        height={96}
        layout="fixed"
        fit="cover"
        position="center"
        class:list={["link-card-image", darkImage ? "dark:hidden" : ""]}
      />
      {
        darkImage && (
          <Image
            src={darkImage}
            alt=""
            width={96}
            height={96}
            layout="fixed"
            fit="cover"
            position="center"
            class="link-card-image hidden dark:block"
          />
        )
      }
    </div>

    <div class="link-card-content">
      <h3 class="link-card-title">{title}</h3>
      <p class="link-card-description">{description}</p>
      <p class="link-card-creator">{creator}</p>
    </div>

    <div aria-hidden="true" class="link-card-arrow-container">
      <Icon
        name="heroicons:chevron-right-16-solid"
        class="link-card-arrow-icon"
      />
    </div>
  </a>
</li>

<style>
  .link-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-radius: 1rem;
    border: 1px solid var(--color-border);
    padding: 1rem;
    background-color: var(--color-bg-surface);
    color: var(--color-text-body);
    transition: box-shadow 200ms;
  }

  .link-card:hover {
    border-color: var(--color-primary);
    background-color: color-mix(in srgb, var(--color-primary) 5%, transparent);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.12);
    transition:
      box-shadow 200ms,
      background-color 200ms,
      border-color 200ms;
  }

  .link-card-thumb {
    flex-shrink: 0;
  }

  .link-card-image {
    border-radius: 0.75rem;
  }

  .link-card-content {
    display: flex;
    min-height: 6rem;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 0.25rem;
  }

  .link-card-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-heading);
  }

  .link-card:hover .link-card-title {
    color: var(--color-primary);
    transition: color 200ms;
  }

  .link-card-description {
    flex: 1;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .link-card-creator {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .link-card-arrow-container {
    pointer-events: none;
    display: flex;
    height: 6rem;
    width: 2rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 0.375rem;
    transform: translateX(-0.75rem);
    opacity: 0;
    background-color: color-mix(in srgb, var(--color-primary) 15%, transparent);
    transition:
      transform 200ms,
      opacity 200ms;
  }

  .link-card:hover .link-card-arrow-container {
    transform: translateX(0);
    opacity: 1;
  }

  .link-card-arrow-icon {
    transform: translateX(-0.75rem);
    opacity: 0;
    color: var(--color-primary);
    transition:
      transform 200ms,
      opacity 200ms;
  }

  .link-card:hover .link-card-arrow-icon {
    transform: translateX(0);
    opacity: 1;
  }
</style>
