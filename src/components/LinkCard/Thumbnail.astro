---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  darkImage?: ImageMetadata;
}

const { image, darkImage } = Astro.props;
const imageClass = "size-20 rounded-lg object-cover sm:size-28";
---

<Image
  src={image}
  alt=""
  width={112}
  height={112}
  densities={[1, 2]}
  fit="cover"
  position="center"
  class:list={[imageClass, darkImage && "dark:hidden"]}
/>
{darkImage && (
  <Image
    src={darkImage}
    alt=""
    width={112}
    height={112}
    densities={[1, 2]}
    fit="cover"
    position="center"
    class:list={[imageClass, "hidden dark:block"]}
  />
)}
