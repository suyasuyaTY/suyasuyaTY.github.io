---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import PostDate from "@components/common/PostDate.astro";
import { getReadingStats } from "../../lib/readingStats";

// 記事一覧用の詳細カード: 日付・タイトル・概要・読了時間・文字数・タグを表示する
// - タイトルは1行、概要は2行分の高さを取り、長さが違ってもカードの高さをそろえる
// - ホバーすると、カードごとに割り当てた青系の色でカード全体を染め、右の > が → に伸びる
interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, tags, createdAt } = post.data;
const url = `/posts/${post.id}`;
const { characters, minutes } = getReadingStats(post.body ?? "");

// 記事 ID から色を決める (ビルドのたびに色が変わらないようにする)
const tints = ["sky", "cyan", "blue", "indigo", "violet"];
const hash = [...post.id].reduce((sum, c) => sum + c.charCodeAt(0), 0);
const tint = tints[hash % tints.length];
---

<article
  style={`--tint: var(--color-tint-${tint}); --tint-strong: var(--color-tint-${tint}-strong);`}
  class="group relative flex items-center gap-4 rounded-2xl border border-(--color-border) bg-(--color-bg-surface) p-4 transition-[background-color,border-color,box-shadow,translate] duration-300 hover:-translate-y-0.5 hover:border-(--tint-strong) hover:bg-(--tint) hover:shadow-lg lg:p-[1.65rem]"
>
  <div class="flex min-w-0 flex-1 flex-col">
    <PostDate
      date={createdAt}
      class="text-xs text-(--color-text-muted) lg:text-[0.9625rem]"
    />

    {/* タイトルのリンクをカード全体に広げる (タグのリンクは手前に出す) */}
    <h3 class="mt-1 line-clamp-1 text-base leading-6 font-bold text-(--color-text-heading) transition-colors duration-300 group-hover:text-(--tint-strong) lg:mt-2 lg:text-[1.375rem] lg:leading-snug">
      <a href={url} class="after:absolute after:inset-0">
        {title}
      </a>
    </h3>

    <p class="line-clamp-2 h-10 text-sm leading-5 text-(--color-text-body) lg:h-[3.3rem] lg:text-[0.9625rem] lg:leading-[1.65rem]">
      {description}
    </p>

    <p class="mt-2 flex items-center gap-3 text-xs text-(--color-text-muted) lg:mt-3 lg:text-[0.825rem]">
      <span class="flex items-center gap-1">
        <Icon
          name="heroicons:clock-20-solid"
          class="h-3.5 w-3.5 lg:h-4 lg:w-4"
        />
        約{minutes}分
      </span>
      <span class="flex items-center gap-1">
        <Icon
          name="heroicons:document-text-20-solid"
          class="h-3.5 w-3.5 lg:h-4 lg:w-4"
        />
        {characters.toLocaleString("ja-JP")}文字
      </span>
    </p>

    <ul class="relative z-10 mt-1.5 flex flex-wrap gap-2 lg:mt-2">
      {tags.map((tag) => (
        <li>
          <a
            href={`/posts/tag/${tag}`}
            class="rounded-md bg-(--color-primary-subtle) px-2 py-0.5 text-xs text-(--color-text-body) transition-colors group-hover:bg-(--color-bg-surface) hover:text-(--color-primary) lg:text-[0.825rem]"
          >
            #{tag}
          </a>
        </li>
      ))}
    </ul>
  </div>

  {/* > の後ろから軸が伸びて → になる */}
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="h-6 w-6 shrink-0 text-(--color-text-muted) transition-colors duration-300 group-hover:text-(--tint-strong) lg:h-7 lg:w-7"
  >
    <path
      d="M5 12h13"
      class="origin-right scale-x-0 transition-transform duration-300 ease-out [transform-box:fill-box] group-hover:scale-x-100"
    ></path>
    <path
      d="M12 5l7 7-7 7"
      class="-translate-x-1.5 transition-transform duration-300 ease-out group-hover:translate-x-0"
    ></path>
  </svg>
</article>
