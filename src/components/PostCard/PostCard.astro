---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import PostDate from "@components/common/PostDate.astro";
import { getReadingStats } from "../../lib/readingStats";

// 記事一覧用の詳細カード: 日付・タイトル・概要・読了時間・タグ (lg 以上は右に OGP 画像) を表示する
// - タイトルと概要は決まった行数の高さを取り、長さが違ってもカードの高さをそろえる
// - lg 以上は文字欄の幅を固定し、OGP 画像はカードの右端に置く。
//   カードが狭くて文字欄と重なる分は、グラデーションの境界を右にずらして隠す。ホバーで画像全体を見せる
interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, tags, createdAt } = post.data;
const url = `/posts/${post.id}`;
const { characters, minutes } = getReadingStats(post.body ?? "");
---

{/* isolate: Safari で translate 中に角丸の切り抜きが外れ、画像の角が見えるのを防ぐ */}
<article class="group @container relative isolate flex overflow-hidden rounded-2xl border border-(--color-border) bg-(--color-bg-surface) transition-[box-shadow,translate] hover:-translate-y-0.5 hover:shadow-lg">
  <div class="flex min-w-0 flex-1 flex-col p-4 lg:w-[34rem] lg:flex-none lg:p-[1.65rem]">
    <PostDate
      date={createdAt}
      class="text-xs text-(--color-text-muted) lg:text-[0.9625rem]"
    />

    {/* タイトルのリンクをカード全体に広げる (タグのリンクは手前に出す) */}
    <h3 class="mt-1 line-clamp-1 text-base leading-6 font-bold text-(--color-text-heading) transition-colors group-hover:text-(--color-primary) lg:mt-2 lg:line-clamp-2 lg:min-h-[2lh] lg:text-[1.375rem] lg:leading-snug">
      <a href={url} class="after:absolute after:inset-0">
        {title}
      </a>
    </h3>

    <p class="line-clamp-2 h-10 text-sm leading-5 text-(--color-text-body) lg:line-clamp-3 lg:h-[4.95rem] lg:text-[0.9625rem] lg:leading-[1.65rem]">
      {description}
    </p>

    <p class="mt-2 flex items-center gap-1 text-xs text-(--color-text-muted) lg:mt-3 lg:text-[0.825rem]">
      <Icon name="heroicons:clock-20-solid" class="h-3.5 w-3.5 lg:h-4 lg:w-4" />
      <span>約{minutes}分</span>
      <span aria-hidden="true">·</span>
      <span>{characters.toLocaleString("ja-JP")}文字</span>
    </p>

    <ul class="relative z-10 mt-1.5 flex flex-wrap gap-2 lg:mt-2">
      {tags.map((tag) => (
        <li>
          <a
            href={`/posts/tag/${tag}`}
            class="rounded-md bg-(--color-primary-subtle) px-2 py-0.5 text-xs text-(--color-text-body) transition-colors hover:text-(--color-primary) lg:text-[0.825rem]"
          >
            #{tag}
          </a>
        </li>
      ))}
    </ul>
  </div>

  {/* 高さはカードに合わせ、幅は 1200:630 の比率で決まる */}
  <img
    src={`/og/${post.id}.png`}
    alt=""
    width={1200}
    height={630}
    loading="lazy"
    decoding="async"
    class="post-card-image pointer-events-none absolute inset-y-0 right-0 -z-10 hidden aspect-[1200/630] h-full w-auto max-w-none group-hover:z-20 lg:block"
  />
</article>

<style>
  @property --reveal {
    syntax: "<length-percentage>";
    inherits: false;
    initial-value: 0%;
  }

  .post-card-image {
    /* 文字欄 (34rem) と重なる幅。重ならなければ 0 */
    --fade-start: max(0px, calc(34rem - 100cqw + 100%));
    mask-image: linear-gradient(
      to right,
      transparent calc(var(--fade-start) - var(--reveal)),
      black calc(var(--fade-start) + 30% - var(--reveal))
    );
    transition: --reveal 0.4s ease;
  }

  /* ホバーでグラデーションを左へ押し出し、画像全体を見せる */
  .group:hover .post-card-image {
    --reveal: 200%;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card-image {
      transition: none;
    }
  }
</style>
