---
import Profile from "../../images/Profile.png";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

const links = [
  {
    href: "https://github.com/suyasuyaTY",
    icon: "github",
    darkIcon: "github-white",
  },
  {
    href: "https://twitter.com/suyasuyaTY",
    icon: "twitter",
  },
  {
    href: "https://zenn.dev/suyasuyaty",
    icon: "zenn",
  },
];
---

<div class="flex flex-col items-center gap-4 sm:flex-row sm:items-center sm:gap-6">
  <Image
    src={Profile}
    alt="Profile Picture"
    class="h-24 w-24 shrink-0 rounded-lg object-cover sm:h-28 sm:w-28"
  />

  <div class="flex flex-col items-center gap-2 sm:items-start">
    <div class="text-xl font-semibold text-(--color-text-heading)">
      suyasuyaTY
    </div>

    <p class="text-center text-sm text-(--color-text-muted) sm:text-left">
      Astro最高! <br />オマエもAstro最高と叫びなさい!!
    </p>

    <div class="mt-2 flex gap-2">
      {
        links.map(({ href, icon, darkIcon }) => (
          <a href={href} title={icon} target="_blank" rel="noopener noreferrer">
            <Icon
              name={icon}
              class:list={["btn-social", darkIcon ? "dark:hidden" : ""]}
              size={32}
            />
            {darkIcon && (
              <Icon
                name={darkIcon}
                class="btn-social hidden dark:block"
                size={32}
              />
            )}
          </a>
        ))
      }
    </div>
  </div>
</div>
