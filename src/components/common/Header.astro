---
import { Icon } from "astro-icon/components";

const navLinks = [
  { href: "/", label: "Home", icon: "heroicons:home-20-solid" },
  {
    href: "/posts",
    label: "Posts",
    icon: "heroicons:archive-box-arrow-down-20-solid",
  },
  {
    href: "/projects",
    label: "Projects",
    icon: "heroicons:wrench-screwdriver-16-solid",
  },
  { href: "/link", label: "Link", icon: "heroicons:link-20-solid" },
];

// ヘッダーは transition:persist で使い回されるので、遷移後はスクリプト側で更新する
const getAriaCurrent = (href: string, pathname: string) => {
  const path = pathname.replace(/\/$/, "") || "/";
  if (path === href) return "page";
  if (href !== "/" && path.startsWith(`${href}/`)) return "true";
  return undefined;
};
---

<!--
  data-floating: 少しスクロールしたら、バーを横に縮めて浮かせる
  data-hidden: 下にスクロールしている間は上に隠す
-->
<header
  id="main-header"
  transition:persist
  transition:name="header"
  transition:animate="initial"
  data-floating="false"
  data-hidden="false"
  data-menu-open="false"
  class="group sticky top-0 z-10 transition-[translate,padding] duration-300 ease-in-out data-[floating=true]:px-4 data-[floating=true]:pt-2 data-[hidden=true]:-translate-y-full"
>
  <div class="relative mx-auto max-w-full bg-(--color-bg-surface) shadow-md transition-[max-width,border-radius,box-shadow] duration-300 ease-in-out group-data-[floating=true]:max-w-4xl group-data-[floating=true]:rounded-2xl group-data-[floating=true]:shadow-lg group-data-[floating=true]:ring-1 group-data-[floating=true]:ring-(--color-border) group-data-[menu-open=true]:rounded-b-none md:rounded-md">
    <nav class="flex items-center justify-between gap-4 px-4 py-2">
      <div class="text-xl font-bold" style="color: var(--color-primary);">
        <a href="/">suyasuyaTY</a>
      </div>

      <div class="flex items-center gap-2">
        <ul class="hidden md:flex md:gap-1">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="nav-link"
                aria-current={getAriaCurrent(link.href, Astro.url.pathname)}
              >
                <Icon name={link.icon} class="hidden lg:block" />
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        <ul class="flex gap-2">
          <li class="text-lg" style="color: var(--color-text-muted);">
            <button
              id="themeToggle"
              aria-label="テーマ切り替え"
              class="flex h-10 w-10 cursor-pointer items-center justify-center rounded hover:bg-(--color-primary-subtle)"
            >
              <Icon
                name="heroicons:sun-solid"
                class="block h-5 w-5 dark:hidden"
              />
              <Icon
                name="heroicons:moon-solid"
                class="hidden h-5 w-5 dark:block"
              />
            </button>
          </li>
          <li class="text-lg md:hidden" style="color: var(--color-text-muted);">
            <button
              id="menuToggle"
              aria-label="メニュー"
              aria-controls="mobileMenu"
              aria-expanded="false"
              class="group/menu flex h-10 w-10 cursor-pointer items-center justify-center rounded hover:bg-(--color-primary-subtle)"
            >
              <!-- 3本線を、開いたら上下の線を回転させて × にする -->
              <span
                aria-hidden="true"
                class="relative block h-3.5 w-5 *:absolute *:left-0 *:h-0.5 *:w-full *:rounded-full *:bg-current *:transition-[translate,rotate,opacity,scale] *:duration-300 *:ease-in-out"
              >
                <span class="top-0 group-aria-expanded/menu:translate-y-1.5 group-aria-expanded/menu:rotate-45"></span>
                <span class="top-1.5 group-aria-expanded/menu:scale-x-0 group-aria-expanded/menu:opacity-0"></span>
                <span class="top-3 group-aria-expanded/menu:-translate-y-1.5 group-aria-expanded/menu:-rotate-45"></span>
              </span>
            </button>
          </li>
        </ul>
      </div>
    </nav>

    <!-- バーの裏から下に引き出すので、外枠ではみ出た分を切り取る -->
    <div class="pointer-events-none absolute inset-x-0 top-full overflow-hidden pb-6 md:hidden">
      <div
        id="mobileMenu"
        data-open="false"
        class="pointer-events-auto invisible -translate-y-full bg-(--color-bg-surface) shadow-xl transition-[translate,visibility] duration-200 ease-out group-data-[floating=true]:rounded-b-2xl data-[open=true]:visible data-[open=true]:translate-y-0"
      >
        <ul class="flex flex-col py-2">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="nav-link"
                aria-current={getAriaCurrent(link.href, Astro.url.pathname)}
              >
                <Icon name={link.icon} />
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  // --- 初期化処理 (以前と同じ) ---
  const getTheme = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
      return "dark";
    }
    return "light";
  };

  const initTheme = () => {
    const theme = getTheme();
    if (theme === "dark") {
      document.documentElement.classList.add("dark");
    } else {
      document.documentElement.classList.remove("dark");
    }
  };

  initTheme();

  document.addEventListener("astro:after-swap", initTheme);
</script>

<script>
  import { navigate } from "astro:transitions/client";

  const menuCloseDurationMs = 200;
  const floatThresholdPx = 16;

  const getAriaCurrent = (href: string, pathname: string) => {
    const path = pathname.replace(/\/$/, "") || "/";
    if (path === href) return "page";
    if (href !== "/" && path.startsWith(`${href}/`)) return "true";
    return null;
  };

  // --- 現在地のハイライト ---
  const updateAriaCurrent = () => {
    document
      .querySelectorAll<HTMLAnchorElement>("#main-header .nav-link")
      .forEach((link) => {
        const current = getAriaCurrent(
          link.getAttribute("href") ?? "",
          location.pathname,
        );
        if (current) link.setAttribute("aria-current", current);
        else link.removeAttribute("aria-current");
      });
  };

  const setup = () => {
    const menuToggleBtn = document.getElementById("menuToggle");
    const mobileMenu = document.getElementById("mobileMenu");
    const header = document.getElementById("main-header");
    const themeToggleBtn = document.getElementById("themeToggle");
    if (!menuToggleBtn || !mobileMenu || !header) return;

    // ヘッダーは persist されるので、イベント登録は最初の1回だけ
    if (header.dataset.init === "true") return;
    header.dataset.init = "true";

    // --- ダークモード切り替え ---
    themeToggleBtn?.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });

    // --- モバイルメニュー開閉 ---
    const isOpen = () => menuToggleBtn.getAttribute("aria-expanded") === "true";

    const setMenu = (open: boolean) => {
      mobileMenu.dataset.open = String(open);
      header.dataset.menuOpen = String(open);
      menuToggleBtn.setAttribute("aria-expanded", String(open));
    };
    const closeMenu = () => setMenu(false);

    menuToggleBtn.addEventListener("click", () => setMenu(!isOpen()));

    // メニュー外のタップと Esc で閉じる
    document.addEventListener("click", (event) => {
      if (isOpen() && !header.contains(event.target as Node)) closeMenu();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !isOpen()) return;
      closeMenu();
      menuToggleBtn.focus();
    });

    // リンククリック時は、メニューが閉じてから遷移する
    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", (event) => {
        if (!isOpen()) return;
        const href = link.getAttribute("href");
        if (!href) return;
        event.preventDefault();
        closeMenu();
        window.setTimeout(() => navigate(href), menuCloseDurationMs);
      });
    });

    window.addEventListener("resize", () => {
      if (window.matchMedia("(min-width: 768px)").matches) closeMenu();
    });
    document.addEventListener("astro:before-swap", closeMenu);

    // --- スクロールでフロート表示にし、さらに下へ進んだら隠す ---
    let lastScrollTop = 0;
    const updateOnScroll = () => {
      const currentScrollTop = Math.max(window.scrollY, 0);
      header.dataset.floating = String(currentScrollTop > floatThresholdPx);
      if (!isOpen()) {
        header.dataset.hidden = String(
          currentScrollTop > lastScrollTop &&
            currentScrollTop > header.offsetHeight * 2,
        );
      }
      lastScrollTop = currentScrollTop;
    };
    window.addEventListener("scroll", updateOnScroll, { passive: true });
    updateOnScroll();
  };

  document.addEventListener("astro:page-load", () => {
    setup();
    updateAriaCurrent();
  });
</script>
