---
import { Icon } from "astro-icon/components";

const navLinks = [
  { href: "/", label: "Home", icon: "heroicons:home-20-solid" },
  {
    href: "/posts",
    label: "Posts",
    icon: "heroicons:archive-box-arrow-down-20-solid",
  },
  {
    href: "/projects",
    label: "Projects",
    icon: "heroicons:wrench-screwdriver-16-solid",
  },
  { href: "/link", label: "Link", icon: "heroicons:link-20-solid" },
];

// ヘッダーは transition:persist で使い回されるので、遷移後はスクリプト側で更新する
const getAriaCurrent = (href: string, pathname: string) => {
  const path = pathname.replace(/\/$/, "") || "/";
  if (path === href) return "page";
  if (href !== "/" && path.startsWith(`${href}/`)) return "true";
  return undefined;
};
---

<header
  id="main-header"
  transition:persist
  transition:name="header"
  transition:animate="initial"
  class="sticky top-0 z-10 bg-(--color-bg-surface) shadow-md transition-transform duration-300 ease-in-out md:rounded-md"
>
  <nav class="mx-auto flex items-center justify-between px-4 py-6 md:px-6">
    <div class="text-xl font-bold" style="color: var(--color-primary);">
      <a href="/">suyasuyaTY</a>
    </div>

    <ul class="hidden gap-4 md:flex md:gap-12">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="nav-link"
            aria-current={getAriaCurrent(link.href, Astro.url.pathname)}
          >
            <Icon name={link.icon} />
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <ul class="flex gap-2">
      <li class="text-lg" style="color: var(--color-text-muted);">
        <button
          id="themeToggle"
          aria-label="テーマ切り替え"
          class="flex h-10 w-10 cursor-pointer items-center justify-center rounded hover:bg-(--color-primary-subtle)"
        >
          <Icon name="heroicons:sun-solid" class="block h-5 w-5 dark:hidden" />
          <Icon name="heroicons:moon-solid" class="hidden h-5 w-5 dark:block" />
        </button>
      </li>
      <li class="text-lg md:hidden" style="color: var(--color-text-muted);">
        <button
          id="menuToggle"
          aria-label="メニュー"
          aria-controls="mobileMenu"
          aria-expanded="false"
          class="flex h-10 w-10 cursor-pointer items-center justify-center rounded hover:bg-(--color-primary-subtle)"
        >
          <Icon
            id="menuIconOpen"
            name="heroicons:bars-3-16-solid"
            class="block h-5 w-5"
          />
          <Icon
            id="menuIconClose"
            name="heroicons:x-mark-solid"
            class="hidden h-5 w-5"
          />
        </button>
      </li>
    </ul>
  </nav>

  <div
    id="mobileMenu"
    data-open="false"
    class="invisible absolute top-full w-full origin-top -translate-y-2 scale-y-95 bg-(--color-bg-surface) opacity-0 shadow-2xl transition-[opacity,transform,visibility] duration-200 ease-out data-[open=true]:visible data-[open=true]:translate-y-0 data-[open=true]:scale-y-100 data-[open=true]:opacity-100 md:hidden"
  >
    <ul class="flex flex-col py-2">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="nav-link"
            aria-current={getAriaCurrent(link.href, Astro.url.pathname)}
          >
            <Icon name={link.icon} />
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script is:inline>
  // --- 初期化処理 (以前と同じ) ---
  const getTheme = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
      return "dark";
    }
    return "light";
  };

  const initTheme = () => {
    const theme = getTheme();
    if (theme === "dark") {
      document.documentElement.classList.add("dark");
    } else {
      document.documentElement.classList.remove("dark");
    }
  };

  initTheme();

  document.addEventListener("astro:after-swap", initTheme);
</script>

<script>
  import { navigate } from "astro:transitions/client";

  const menuCloseDurationMs = 200;

  const getAriaCurrent = (href: string, pathname: string) => {
    const path = pathname.replace(/\/$/, "") || "/";
    if (path === href) return "page";
    if (href !== "/" && path.startsWith(`${href}/`)) return "true";
    return null;
  };

  // --- 現在地のハイライト ---
  const updateAriaCurrent = () => {
    document
      .querySelectorAll<HTMLAnchorElement>("#main-header .nav-link")
      .forEach((link) => {
        const current = getAriaCurrent(
          link.getAttribute("href") ?? "",
          location.pathname,
        );
        if (current) link.setAttribute("aria-current", current);
        else link.removeAttribute("aria-current");
      });
  };

  const setup = () => {
    const menuToggleBtn = document.getElementById("menuToggle");
    const mobileMenu = document.getElementById("mobileMenu");
    const iconOpen = document.getElementById("menuIconOpen");
    const iconClose = document.getElementById("menuIconClose");
    const header = document.getElementById("main-header");
    const themeToggleBtn = document.getElementById("themeToggle");
    if (!menuToggleBtn || !mobileMenu || !header) return;

    // ヘッダーは persist されるので、イベント登録は最初の1回だけ
    if (header.dataset.init === "true") return;
    header.dataset.init = "true";

    // --- ダークモード切り替え ---
    themeToggleBtn?.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });

    // --- モバイルメニュー開閉 ---
    const isOpen = () => menuToggleBtn.getAttribute("aria-expanded") === "true";

    const setMenu = (open: boolean) => {
      mobileMenu.dataset.open = String(open);
      menuToggleBtn.setAttribute("aria-expanded", String(open));
      iconOpen?.classList.toggle("hidden", open);
      iconClose?.classList.toggle("hidden", !open);
    };
    const closeMenu = () => setMenu(false);

    menuToggleBtn.addEventListener("click", () => setMenu(!isOpen()));

    // メニュー外のタップと Esc で閉じる
    document.addEventListener("click", (event) => {
      if (isOpen() && !header.contains(event.target as Node)) closeMenu();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !isOpen()) return;
      closeMenu();
      menuToggleBtn.focus();
    });

    // リンククリック時は、メニューが閉じてから遷移する
    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", (event) => {
        if (!isOpen()) return;
        const href = link.getAttribute("href");
        if (!href) return;
        event.preventDefault();
        closeMenu();
        window.setTimeout(() => navigate(href), menuCloseDurationMs);
      });
    });

    window.addEventListener("resize", () => {
      if (window.matchMedia("(min-width: 768px)").matches) closeMenu();
    });
    document.addEventListener("astro:before-swap", closeMenu);

    // --- スクロールで隠す ---
    let lastScrollTop = 0;
    window.addEventListener(
      "scroll",
      () => {
        if (isOpen()) return;
        const currentScrollTop = window.scrollY;
        header.classList.toggle(
          "-translate-y-full",
          currentScrollTop > lastScrollTop &&
            currentScrollTop > header.offsetHeight,
        );
        lastScrollTop = Math.max(currentScrollTop, 0);
      },
      { passive: true },
    );
  };

  document.addEventListener("astro:page-load", () => {
    setup();
    updateAriaCurrent();
  });
</script>
