---
import { Icon } from "astro-icon/components";

const navLinks = [
  { href: "/", label: "Home", icon: "heroicons:home-20-solid" },
  {
    href: "/posts",
    label: "Posts",
    icon: "heroicons:archive-box-arrow-down-20-solid",
  },
  {
    href: "/projects",
    label: "Projects",
    icon: "heroicons:wrench-screwdriver-16-solid",
  },
  { href: "/link", label: "Link", icon: "heroicons:link-20-solid" },
];
---

<header
  id="main-header"
  class="sticky top-0 z-10 rounded-md bg-(--color-bg-surface) shadow-md transition-transform duration-300 ease-in-out"
>
  <nav class="mx-auto flex items-center justify-between px-4 py-6 md:px-6">
    <div class="text-xl font-bold" style="color: var(--color-primary);">
      <a href="/">suyasuyaTY</a>
    </div>

    <ul class="flex gap-4 md:gap-12">
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href} class="nav-link">
              <Icon name={link.icon} />
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <ul class="flex gap-2">
      <li class="text-lg" style="color: var(--color-text-muted);">
        <button
          id="themeToggle"
          aria-label="themeToggle"
          class="flex h-10 w-10 cursor-pointer items-center justify-center rounded hover:bg-(--color-primary-subtle)"
        >
          <Icon
            name="heroicons:sun-20-solid"
            class="block h-5 w-5 dark:hidden"
          />
          <Icon
            name="heroicons:moon-20-solid"
            class="hidden h-5 w-5 dark:block"
          />
        </button>
      </li>
    </ul>
  </nav>
</header>

<script is:inline>
  // --- 初期化処理 (以前と同じ) ---
  const getTheme = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
      return "dark";
    }
    return "light";
  };

  const initTheme = () => {
    const theme = getTheme();
    if (theme === "dark") {
      document.documentElement.classList.add("dark");
    } else {
      document.documentElement.classList.remove("dark");
    }
  };

  // 初回読み込み時に即実行
  initTheme();

  // ページ遷移後（View Transitions）にもテーマを再適用する
  // これがないと、遷移先でライトモードに戻ってしまうことがあります
  document.addEventListener("astro:after-swap", initTheme);
</script>

<script is:inline>
  // メインの処理
  document.addEventListener("astro:page-load", () => {
    // ---------------------------------------------------------
    // 1. ダークモード切り替えボタンの処理
    // ---------------------------------------------------------
    const themeToggleBtn = document.getElementById("themeToggle");
    if (themeToggleBtn) {
      themeToggleBtn.addEventListener("click", () => {
        const element = document.documentElement;
        element.classList.toggle("dark");
        const isDark = element.classList.contains("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      });
    }

    // ---------------------------------------------------------
    // 2. スクロール処理 (重複登録防止つき)
    // ---------------------------------------------------------
    const header = document.getElementById("main-header");
    let lastScrollTop = 0;

    const handleScroll = () => {
      // ヘッダーが存在しないページでは何もしない
      if (!header) return;

      const currentScrollTop =
        window.scrollY || document.documentElement.scrollTop;

      if (
        currentScrollTop > lastScrollTop &&
        currentScrollTop > header.offsetHeight
      ) {
        // 下にスクロール & ヘッダーより下にいる時 -> 隠す
        header.classList.add("-translate-y-full");
      } else {
        // 上にスクロール -> 表示
        header.classList.remove("-translate-y-full");
      }

      lastScrollTop = currentScrollTop <= 0 ? 0 : currentScrollTop;
    };

    if (header) {
      // イベント登録 (passive: true はスクロール性能向上のため)
      window.addEventListener("scroll", handleScroll, { passive: true });
    }

    // ★重要: ページを離れるときにイベントを削除する
    // これをしないと、ページ移動のたびにスクロール監視が積み重なって重くなります
    document.addEventListener(
      "astro:before-swap",
      () => {
        window.removeEventListener("scroll", handleScroll);
      },
      { once: true }
    );
  });
</script>
