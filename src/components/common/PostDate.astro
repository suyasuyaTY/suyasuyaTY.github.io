---
// 記事の日付を「2025年12月05日」の形で、ドット絵風のフォントで表示する
interface Props {
  date: Date;
  class?: string;
}

const { date, class: className } = Astro.props;

// frontmatter の日付は UTC の 0 時なので、UTC で年月日を取り出す
const pad = (n: number) => String(n).padStart(2, "0");
const label = `${date.getUTCFullYear()}年${pad(date.getUTCMonth() + 1)}月${pad(date.getUTCDate())}日`;
const iso = date.toISOString().split("T")[0];
---

<time datetime={iso} class:list={["font-dot tabular-nums", className]}>
  {label}
</time>
