---
import Profile from "../../images/Profile.png";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

const allBlogPosts = await getCollection("blog");
const categoryCounts = new Map<string, number>();
allBlogPosts.forEach((post) => {
  if (post.data.draft === true) return;

  const category = post.data.category;
  categoryCounts.set(category, (categoryCounts.get(category) || 0) + 1);
});
const sortedCategories = Array.from(categoryCounts.entries()).sort(
  (a, b) => b[1] - a[1]
);

const links = [
  {
    href: "https://github.com/suyasuyaTY",
    icon: "github",
    darkIcon: "github-white",
  },
  {
    href: "https://twitter.com/suyasuyaTY",
    icon: "twitter",
  },
  {
    href: "https://zenn.dev/suyasuyaty",
    icon: "zenn",
  },
];
---

<section class="widget-card">
  <Image
    src={Profile}
    alt="Profile Picture"
    class="mx-auto h-32 w-32 rounded-lg object-cover md:h-auto md:w-auto"
    loading="eager"
    fetchpriority="high"
  />

  <div
    class="py-4 text-center text-xl font-semibold text-(--color-text-heading)"
  >
    suyasuyaTY
  </div>

  <p class="text-center text-sm text-(--color-text-muted)">
    Astro最高! <br />オマエもAstro最高と叫びなさい!!
  </p>

  <div class="mt-4 flex justify-center gap-2">
    {
      links.map(({ href, icon, darkIcon }) => (
        <a href={href} title={icon} target="_blank" rel="noopener noreferrer">
          <Icon
            name={icon}
            class:list={["btn-social", darkIcon ? "dark:hidden" : ""]}
            size={36}
          />
          {darkIcon && (
            <Icon
              name={darkIcon}
              class="btn-social hidden dark:block"
              size={36}
            />
          )}
        </a>
      ))
    }
  </div>
</section>

<section class="widget-card">
  <div class="text-md mb-4 font-semibold text-(--color-text-muted)">
    カテゴリー
  </div>
  <ul class="flex flex-col gap-3">
    {
      sortedCategories.map(([category, count]) => (
        <li>
          <a href={`/posts/category/${category}`} class="link-category">
            <span>{category}</span>
            <span>{count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
