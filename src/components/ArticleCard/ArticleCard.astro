---
import { Icon } from "astro-icon/components";
import PostDate from "@components/common/PostDate.astro";

// TOP 用の簡易カード: 日付・タイトル・矢印だけを表示する
interface Props {
  title: string;
  createdAt: Date;
  url: string;
}

const { title, createdAt, url } = Astro.props;

const isExternalUrl = (href: string, base: URL) => {
  try {
    const u = new URL(href, base); // 相対でもOK
    return u.origin !== base.origin;
  } catch {
    return false;
  }
};

const isExternal = isExternalUrl(url, Astro.url);

const linkAttrs = isExternal
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};
---

<a
  href={url}
  {...linkAttrs}
  class="group flex items-center gap-4 rounded-lg px-4 py-3 transition-colors hover:bg-(--color-primary-subtle)"
>
  <PostDate
    date={createdAt}
    class="shrink-0 text-sm text-(--color-text-muted)"
  />

  <span class="min-w-0 flex-1 font-bold text-(--color-text-heading) transition-colors group-hover:text-(--color-primary)">
    {title}
  </span>

  <Icon
    name={
      isExternal
        ? "heroicons:arrow-top-right-on-square-20-solid"
        : "heroicons:arrow-right-20-solid"
    }
    class="h-5 w-5 shrink-0 text-(--color-text-muted) transition-[color,translate] group-hover:translate-x-1 group-hover:text-(--color-primary)"
  />
</a>
