---
import { Image } from "astro:assets";

interface Props {
  title: string;
  createdAt: string;
  thumbnail: string | ImageMetadata;
  url: string;
}

const { title, createdAt, url, thumbnail } = Astro.props;

const isExternal =
  url.startsWith("http://") || url.startsWith("https://")
    ? new URL(url).hostname !== Astro.url.hostname
    : false;

const target = isExternal ? "_blank" : undefined;
const rel = isExternal ? "noopener noreferrer" : undefined;
const imageClass = "h-full aspect-square object-cover rounded-r-sm";
---

<a href={url} target={target} rel={rel} class="article-card">
  <div class="flex flex-1 flex-col justify-between px-4 py-4">
    <div class="text-normal font-bold text-(--color-text-heading)">
      {title}
    </div>

    <p class="text-xs text-(--color-text-muted)">
      {createdAt}
    </p>
  </div>
  {
    typeof thumbnail === "string" ? (
      <img src={thumbnail} alt={title} class={imageClass} loading="lazy" />
    ) : (
      <Image
        src={thumbnail}
        alt={title}
        class="aspect-[1.91/1] flex-0 object-contain"
      />
    )
  }
</a>
