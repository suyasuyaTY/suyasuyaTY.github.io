---
import { Image } from "astro:assets";
import styles from "./ArticleCard.module.css";

interface Props {
  title: string;
  createdAt: string;
  thumbnail: string | ImageMetadata;
  url: string;
}

const { title, createdAt, url, thumbnail } = Astro.props;

const isExternalUrl = (href: string, base: URL) => {
  try {
    const u = new URL(href, base); // 相対でもOK
    return u.origin !== base.origin;
  } catch {
    return false;
  }
};

const isExternal = isExternalUrl(url, Astro.url);

const linkAttrs = isExternal
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};
const imageClass = "aspect-[1.91/1] flex-0 object-contain";
---

<a href={url} {...linkAttrs} class={styles.articleCard}>
  <div class="flex flex-1 flex-col justify-between px-4 py-4">
    <div class="text-normal font-bold text-(--color-text-heading)">
      {title}
    </div>

    <p class="text-xs text-(--color-text-muted)">
      {createdAt}
    </p>
  </div>
  {
    typeof thumbnail === "string" ? (
      <img src={thumbnail} alt={title} class={imageClass} loading="lazy" />
    ) : (
      <Image src={thumbnail} alt={title} class={imageClass} />
    )
  }
</a>
