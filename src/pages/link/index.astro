---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";

import LinkCard from "@components/LinkCard/LinkCard.astro";

const friends = await getCollection("links");
---

<Layout title="リンク | すやすやログ">
  <section>
    <h2>Friends</h2>
    <ul class="grid grid-cols-1 gap-6 py-4 lg:grid-cols-2">
      {friends.map(({ data }) => <LinkCard {...data} />)}
    </ul>
  </section>
</Layout>
