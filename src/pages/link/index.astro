---
import BaseLayout from "@layouts/BaseLayout.astro";
import { socials, friends, thanks } from "./link.ts";

import LinkCard from "@components/LinkCard/LinkCard.astro";
import H2 from "@components/common/H2.astro";
---

<BaseLayout title="リンク | suyasuyaTYの部屋">
  <section>
    <H2>External service</H2>
    <ul class="grid grid-cols-1 gap-6 py-4 sm:grid-cols-2">
      {socials.map((item) => <LinkCard {...item} />)}
    </ul>
  </section>

  <section>
    <H2>Friends</H2>
    <ul class="grid grid-cols-1 gap-6 py-4 sm:grid-cols-2">
      {friends.map((item) => <LinkCard {...item} />)}
    </ul>
  </section>

  <section>
    <H2>Powered by</H2>
    <ul class="grid grid-cols-1 gap-6 py-4 sm:grid-cols-2">
      {thanks.map((item) => <LinkCard {...item} />)}
    </ul>
  </section>
</BaseLayout>
