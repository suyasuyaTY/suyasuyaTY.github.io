---
import Layout from "@layouts/Layout.astro";
import PostCardList from "@components/PostCard/PostCardList.astro";
import PostsWithTaxonomy from "@components/PostTaxonomy/PostsWithTaxonomy.astro";
import { getCollection } from "astro:content";

const allBlogPosts = await getCollection("blog");
const posts = allBlogPosts
  .filter((post) => (import.meta.env.PROD ? post.data.draft !== true : true))
  .sort((a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime());
---

<Layout title="記事一覧 | すやすやログ" bare>
  <PostsWithTaxonomy>
    <h2>Posts</h2>

    <PostCardList posts={posts} />
  </PostsWithTaxonomy>
</Layout>
