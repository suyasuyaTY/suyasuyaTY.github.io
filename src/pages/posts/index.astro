---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";

const allBlogPosts = await getCollection("blog");
const posts = allBlogPosts
  .filter((post) => (import.meta.env.PROD ? post.data.draft !== true : true))
  .sort((a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime());
---

<Layout title="記事一覧 | suyasuyaTYの部屋">
  <h2>Posts</h2>

  <ul class="timeline-list my-4">
    {
      posts.map((post) => (
        <li class="timeline-item">
          <a href={`/posts/${post.id}`} class="flex items-baseline gap-4">
            <div class="timeline-date">
              {post.data.createdAt.toISOString().split("T")[0]}
            </div>

            <div class="min-w-0 flex-1 truncate text-xl font-semibold text-(--color-text-heading)">
              {post.data.title}
            </div>

            <div class="w-[10%] shrink-0 truncate text-right">
              {post.data.tags.map((tag) => (
                <span class="timeline-tag">#{tag}</span>
              ))}
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
