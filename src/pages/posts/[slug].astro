---
import { Icon } from "astro-icon/components";
import { getCollection, getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import TableOfContents from "@components/TableOfContents/TableOfContents.astro";
import TocDrawer from "@components/TableOfContents/TocDrawer.astro";
import ProfileCard from "@components/Profile/ProfileCard.astro";
import ShareButtons from "@components/ShareButtons/ShareButtons.astro";
import PostDate from "@components/common/PostDate.astro";
import { getReadingStats } from "../../lib/readingStats";

export async function getStaticPaths() {
  const allBlogPosts = await getCollection("blog");
  return allBlogPosts
    .filter((post) => (import.meta.env.PROD ? post.data.draft !== true : true))
    .map((post) => ({
      params: { slug: post.id },
    }));
}

const { slug } = Astro.params;
const entry = await getEntry("blog", slug);

if (!entry) {
  throw new Error("Could not find blog post");
}
const { Content, headings, remarkPluginFrontmatter } = await render(entry);

const { createdAt, updatedAt } = entry.data;
const isUpdated = updatedAt.getTime() !== createdAt.getTime();
const { characters, minutes } = getReadingStats(entry.body ?? "");
const hasToc = headings.some(({ depth }) => depth === 2 || depth === 3);
const pageUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.href;
---

<Layout
  title={`${remarkPluginFrontmatter["title"]} | すやすやログ`}
  description={remarkPluginFrontmatter["description"]}
  ogImage={`/og/${entry.id}.png`}
  ogType="article"
  bare
>
  {/* 本文のカードと目次を隣同士に置く (目次はカードの外で本文の横に固定) */}
  <div class="mx-auto w-full lg:grid lg:max-w-[72rem] lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-x-8">
    <div class="flex min-w-0 flex-col gap-4">
      <article class="widget-card md:px-10 md:py-10">
        <header>
          <h1 class="text-2xl font-bold text-(--color-text-heading) md:text-3xl">
            {remarkPluginFrontmatter["title"]}
          </h1>

          <div class="my-4 flex flex-wrap gap-x-4 gap-y-2 text-sm font-bold text-(--color-text-muted) md:text-base">
            {/* 日付 */}
            <div class="flex items-center gap-2">
              <Icon
                name="heroicons:calendar-days-20-solid"
                size={28}
                class="icon-badge"
              />
              <PostDate date={createdAt} />
              {isUpdated && (
                <span class="flex items-center gap-1">
                  <Icon name="heroicons:arrow-path-20-solid" size={16} />
                  <PostDate date={updatedAt} />
                </span>
              )}
            </div>

            {/* カテゴリ */}
            <div class="flex items-center gap-2">
              <Icon name="heroicons:tag" size={28} class="icon-badge" />
              <a
                href={`/posts/category/${entry.data.category}`}
                class="rounded p-1 transition-colors hover:bg-(--color-primary-subtle) hover:text-(--color-primary)"
              >
                {entry.data.category}
              </a>
            </div>

            {/* 読了時間 */}
            <div class="flex items-center gap-2">
              <Icon
                name="heroicons:clock-20-solid"
                size={28}
                class="icon-badge"
              />
              <span>
                約{minutes}分で読めます（
                {characters.toLocaleString("ja-JP")}文字）
              </span>
            </div>

            {/* タグ */}
            <div class="flex items-center gap-2">
              <Icon name="heroicons:hashtag" size={28} class="icon-badge" />
              <div class="flex flex-wrap gap-1">
                {entry.data.tags.map((tag, index) => (
                  <>
                    <a
                      href={`/posts/tag/${tag}`}
                      class="rounded p-1 transition-colors hover:bg-(--color-primary-subtle) hover:text-(--color-primary)"
                    >
                      {tag}
                    </a>
                    {index < entry.data.tags.length - 1 && (
                      <span class="py-1">/</span>
                    )}
                  </>
                ))}
              </div>
            </div>
          </div>

          {/* サムネがある記事だけトップ画像を表示する */}
          {entry.data.thumbnail && (
            <div
              class="mb-8 w-full overflow-hidden rounded-xl shadow-sm"
              style="background-color: var(--color-bg-surface);"
            >
              <Image
                src={entry.data.thumbnail}
                alt={entry.data.title}
                width={1200}
                height={630}
                class="aspect-[1.91/1] h-full w-full object-cover"
              />
            </div>
          )}

          {/* AI 要約 (frontmatter の summary) */}
          <section
            aria-label="AI要約"
            class="mb-8 rounded-xl border border-(--color-border) bg-(--color-primary-subtle) p-5"
          >
            <p class="mb-2 flex items-center gap-2 text-sm font-bold text-(--color-primary)">
              <Icon name="heroicons:sparkles-20-solid" class="h-5 w-5" />
              AI要約
            </p>
            <p class="leading-relaxed text-(--color-text-body)">
              {entry.data.summary}
            </p>
            <p class="mt-3 text-xs text-(--color-text-muted)">
              この要約は AI が生成したものです。
            </p>
          </section>
        </header>

        <div class="prose prose-blue dark:prose-invert max-w-none">
          <Content />
        </div>

        <footer class="mt-12 flex flex-col items-end gap-3 border-t border-(--color-border) pt-6">
          <p class="text-sm font-bold text-(--color-text-muted)">
            この記事をシェアする
          </p>
          <ShareButtons
            title={remarkPluginFrontmatter["title"]}
            url={pageUrl}
          />
        </footer>
      </article>

      <section aria-label="この記事を書いた人" class="widget-card md:px-10">
        <p class="mb-4 text-sm font-bold text-(--color-text-muted)">
          この記事を書いた人
        </p>
        <ProfileCard />
      </section>
    </div>

    {hasToc && (
      <nav aria-label="目次" class="hidden lg:block">
        <div class="sticky top-28 pt-2">
          <TableOfContents headings={headings} />
        </div>
      </nav>
    )}
  </div>

  {hasToc && <TocDrawer headings={headings} />}
</Layout>
