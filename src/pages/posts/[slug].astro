---
import { Icon } from "astro-icon/components";
import { getCollection, getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const allBlogPosts = await getCollection("blog");
  return allBlogPosts
    .filter((post) => (import.meta.env.PROD ? post.data.draft !== true : true))
    .map((post) => ({
      params: { slug: post.id },
    }));
}

const { slug } = Astro.params;
const entry = await getEntry("blog", slug);

if (!entry) {
  throw new Error("Could not find blog post");
}
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
---

<BaseLayout title={`${remarkPluginFrontmatter["title"]} | suyasuyaTYの部屋`}>
  <article>
    <div>
      <h1 class="text-3xl font-bold text-(--color-text-heading)">
        {remarkPluginFrontmatter["title"]}
      </h1>

      <div class="text-md my-4 flex gap-4 font-bold text-(--color-text-muted)">
        {/* 日付 */}
        <div class="flex items-center gap-2">
          <Icon
            name="heroicons:calendar-days-20-solid"
            size={32}
            class="icon-badge"
          />
          <span>
            {remarkPluginFrontmatter["createdAt"].toISOString().split("T")[0]}
          </span>
        </div>

        {/* カテゴリ */}
        <div class="flex items-center gap-2">
          <Icon name="heroicons:tag" size={32} class="icon-badge" />
          <a
            href={`/posts/category/${entry.data.category}`}
            class="rounded p-1 transition-colors hover:bg-(--color-primary-subtle) hover:text-(--color-primary)"
          >
            {entry.data.category}
          </a>
        </div>

        {/* タグ */}
        <div class="flex items-center gap-2">
          <Icon name="heroicons:hashtag" size={32} class="icon-badge" />
          <div class="flex gap-1">
            {
              entry.data.tags.map((tag, index) => (
                <>
                  <a
                    href={`/posts/tag/${tag}`}
                    class="rounded p-1 transition-colors hover:bg-(--color-primary-subtle) hover:text-(--color-primary)"
                  >
                    {tag}
                  </a>
                  {index < entry.data.tags.length - 1 && (
                    <span class="py-1">/</span>
                  )}
                </>
              ))
            }
          </div>
        </div>
      </div>

      <div
        class="mb-8 w-full overflow-hidden rounded-xl shadow-sm"
        style="background-color: var(--color-bg-surface);"
      >
        <Image
          src={entry.data.thumbnail}
          alt={entry.data.title}
          width={1200}
          height={630}
          class="aspect-[1.91/1] h-full w-full object-cover"
        />
      </div>

      <div class="prose prose-blue dark:prose-invert max-w-none">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
