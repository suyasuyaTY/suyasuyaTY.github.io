---
import Layout from "@layouts/Layout.astro";
import PostCardList from "@components/PostCard/PostCardList.astro";
import PostsWithTaxonomy from "@components/PostTaxonomy/PostsWithTaxonomy.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const tags = Array.from(
    new Set((await getCollection("blog")).flatMap((post) => post.data.tags)),
  );

  return tags.map((tag) => ({
    params: { tag },
  }));
}

const { tag } = Astro.params;

const allBlogPosts = await getCollection("blog");
const filteredPosts = allBlogPosts
  .filter((post) => post.data.tags.includes(tag))
  .filter((post) => (import.meta.env.PROD ? post.data.draft !== true : true))
  .sort((a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime());
---

<Layout title={`#${tag} | すやすやログ`} bare>
  <PostsWithTaxonomy>
    <h2>#{tag}</h2>

    <PostCardList posts={filteredPosts} />
  </PostsWithTaxonomy>
</Layout>
