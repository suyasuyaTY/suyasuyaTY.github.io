---
import ArticleCard from "@components/ArticleCard/ArticleCard.astro";
import ExprienceCard from "@components/ExprienceCard/ExprienceCard.astro";

import H2 from "@components/common/H2.astro";
import H3 from "@components/common/H3.astro";

import BaseLayout from "@layouts/BaseLayout.astro";

import { getCollection, getEntry } from "astro:content";

const profileEntry = await getEntry("profiles", "suyasuyaty");

if (!profileEntry) {
  throw new Error("プロフィールが見つかりません");
}

const profile = profileEntry.data;
const { experiences, skills, certifications, hobbys } = profile;

const allBlogPosts = await getCollection("blog");
const recentPosts = allBlogPosts
  .sort((a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime())
  .slice(0, 5);
---

<BaseLayout title="About | suyasuyaTYの部屋">
  <section>
    <H2>About me</H2>
    <div class="flex flex-col gap-8 py-6">
      <section>
        <h3 class="text-lg font-bold">所属</h3>
        <ul>
          <li>{profile.role}</li>
        </ul>
      </section>
      <section>
        <h3 class="text-lg font-bold">興味</h3>
        <p class="whitespace-pre-wrap">{profile.bio}</p>
      </section>
      <section>
        <h3 class="text-lg font-bold">趣味</h3>
        <div class="flex flex-wrap gap-2">
          {hobbys.map((hobby) => <span>#{hobby} </span>)}
        </div>
      </section>
    </div>
  </section>

  <section>
    <H2 class="text-4xl">Articles</H2>
    <div class="flex flex-col gap-4 py-4">
      <section>
        <H3>Posts</H3>
        <ul class="my-4 flex flex-col gap-2">
          {
            recentPosts.map((post) => (
              <li>
                <ArticleCard
                  title={post.data.title}
                  createdAt={post.data.createdAt.toISOString().split("T")[0]}
                  thumbnail={post.data.thumbnail}
                  url={`/posts/${post.id}`}
                />
              </li>
            ))
          }
        </ul>
        <section class="my-4">
          <H3>Zenn</H3>
          <ul class="my-4 flex flex-col gap-2">
            {
              recentPosts.map((post) => (
                <li>
                  <ArticleCard
                    title={post.data.title}
                    createdAt={post.data.createdAt.toISOString().split("T")[0]}
                    thumbnail={post.data.thumbnail}
                    url={`/posts/${post.id}`}
                  />
                </li>
              ))
            }
          </ul>
        </section>
      </section>
    </div>
    {
      /* <section>
    <h2 class="text-4xl">Projects</h2>
    <div></div>
  </section>*/
    }

    <section>
      <H2>Skills</H2>
      <ul class="my-4 flex flex-col gap-4">
        {
          skills.map((skillGroup) => (
            <li>
              <H3>{skillGroup.category}</H3>
              <p class="font-normal">{skillGroup.items.join(", ")}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <H2>Certifications</H2>
      <div>
        <ul class="my-4 flex flex-col gap-4">
          {
            certifications.map((cert) => (
              <li class="rounded-xl border px-8 py-4">
                <h3 class="text-xl font-semibold text-black">{cert.title}</h3>
                <time class="text-xs font-light">{cert.date}</time>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section>
      <H2>Experience</H2>
      <div>
        <ul class="my-4 px-4">
          {
            experiences.map((exp) => (
              <ExprienceCard
                title={exp.title}
                subTitle={exp.subTitle}
                description={exp.description}
                date={exp.date}
                category={exp.category}
                href={exp.href}
              />
            ))
          }
        </ul>
      </div>
    </section>
  </section>
</BaseLayout>
